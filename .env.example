# LiveKit Cloud project: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound SIP trunk linked to ONE Twilio phone number.
SIP_OUTBOUND_TRUNK_ID=
CALLER_ID=

# These are SEPARATE pipeline stages, accessed through LiveKit Inference.
# You do not need separate Deepgram, OpenAI, or Cartesia API keys.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-5.4-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
LLM_REASONING_EFFORT=none

# semantic uses LiveKit's local semantic turn detector plus Silero VAD.
# vad is a simpler fallback that does not need the turn-detector download.
TURN_DETECTION=semantic
MIN_ENDPOINT_DELAY=0.65
MAX_ENDPOINT_DELAY=3.0
MAX_CALL_SECONDS=180
SILENCE_TIMEOUT_SECONDS=30
PRACTICE_TIMEZONE=America/Los_Angeles
PRACTICE_PROFILE=practice-profile.json
ARTIFACTS_DIR=artifacts

# Only needed for the optional `create-trunk` helper. These are NOT Twilio's
# account SID/auth token: use the SIP Credential List username/password.
SIP_TRUNK_ADDRESS=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
